# Azure Event Hub Connection String
# Replace with your actual Azure IoT Hub Event Hub-compatible connection string
# Format: Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<key>;EntityPath=<entity-path>
AZURE_EVENTHUB_CONNECTION_STRING=Endpoint=sb://your-endpoint.servicebus.windows.net/;SharedAccessKeyName=iothubowner;SharedAccessKey=your-key;EntityPath=your-entity-path

# Mock Mode for Testing
# Set to "true" to use mock data for testing without Azure
# Set to "false" to connect to actual Azure Event Hub
USE_MOCK_DATA=false
